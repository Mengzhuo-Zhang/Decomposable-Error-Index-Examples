begin
;*******************************************************
GCMn = (/"ACCESS-ESM1-5","AWI-CM-1-1-MR","BCC-CSM2-MR","CAMS-CSM1-0",\
        "CESM2-WACCM","CESM2","CIESM","CanESM5","E3SM-1-1","EC-Earth3",\
        "FGOALS-f3-L","FGOALS-g3","FIO-ESM-2-0","GFDL-ESM4","GISS-E2-1-G","GISS-E2-1-H",\
        "INM-CM5-0","IPSL-CM6A-LR","KACE-1-0-G","MCM-UA-1-0","MIROC6","MPI-ESM1-2-HR",\
        "MPI-ESM1-2-LR","MRI-ESM2-0","NESM3","NorESM2-MM"/)

Nmodel = dimsizes(GCMn)
N_CMIP5 = 26

f := addfile("../eval_data/E-AS.eval.DEI.tas.JJA.climatemean.nc","r")
istats := f->stats
CVEI := f->DEI/ istats(0,2)
Con := f->ErrorPenalty / istats(0,2)

CVEI := CVEI(N_CMIP5:)
Con := Con(N_CMIP5:,:)

print(istats(0,2))

do i = 0,(Nmodel-1)
  print(GCMn(i)+": "+sprintf("%3.2f",istats(i+N_CMIP5,0)))
  print(GCMn(i)+": "+sprintf("%3.2f",istats(i+N_CMIP5,1)));/istats(i+N_CMIP5,2))
  print(GCMn(i)+":"+sprintf("%3.2f",istats(i+N_CMIP5,3)))
end do
   

